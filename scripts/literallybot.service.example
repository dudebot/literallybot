[Unit]
Description=LiterallyBot Discord Bot
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=YOUR_USERNAME
Group=YOUR_USERNAME
WorkingDirectory=/path/to/literallybot
ExecStart=/path/to/literallybot/start.sh
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
